# Copy to .env and fill in. Never commit .env.
# All settings are read with the SV_ prefix (see sentinel_vantage/core/config.py).

# Environment
SV_ENVIRONMENT=development

# Postgres (matches deploy/docker-compose.yml)
SV_POSTGRES_DSN=postgresql://sentinel:sentinel@localhost:5432/sentinel

# Redis
SV_REDIS_URL=redis://localhost:6379/0

# Market data provider (Polygon.io)
SV_PROVIDER_NAME=polygon
SV_POLYGON_API_KEY=
# feed_mode records provenance on every bar/score: delayed (Starter tier) or realtime (Advanced tier)
SV_FEED_MODE=delayed
# Proactively pace Polygon REST calls to stay under the tier quota.
# 5 = free/Basic tier (5 req/min). Set 0 (or a large number) for paid tiers.
SV_POLYGON_REQUESTS_PER_MINUTE=5

# MCP server (streamable-http transport)
SV_MCP_HOST=0.0.0.0
SV_MCP_PORT=8080
# Host interface the MCP port is published on (compose-time; also settable inline:
# `SV_MCP_BIND=100.x.x.x docker compose ... up`). Default 0.0.0.0 (all). For plain HTTP
# over Tailscale set it to the box's tailnet IP so it's reachable only over the tailnet.
SV_MCP_BIND=0.0.0.0
# Host port the MCP endpoint is published on (compose-time). Default 8080. Set to 80 for
# a port-less http://sentinel-vantage.ai/mcp — port 80 must be free on SV_MCP_BIND first
# (AdGuard holds 0.0.0.0:80, so rebind AdGuard to the LAN IP to free the tailnet IP's 80).
SV_MCP_PUBLISH_PORT=8080
# Bearer token required on /mcp requests. Leave empty for local dev; set a strong random
# value before exposing the server on a network (e.g. `openssl rand -hex 32`).
SV_MCP_AUTH_TOKEN=

# Research worker cycle: which strategies the market worker scores on a cadence (JSON
# list) and how often (seconds). Fundamentals change slowly, so this is far slower than
# the trend cadence. Persisted scores feed get_research_history; ranks warm a Redis cache.
SV_RESEARCH_STRATEGIES=["GARP"]
SV_RESEARCH_SCORING_INTERVAL_SECONDS=3600

# Scheduled daily backfill (scheduler process). Enable to pull the latest bars every day
# so the scored "as of" tracks the latest session without a manual sv-backfill. Hour/
# minute are UTC (US market closes 20:00 UTC); days = trailing window to refill.
SV_DAILY_BACKFILL_ENABLED=false
SV_DAILY_BACKFILL_HOUR=23
SV_DAILY_BACKFILL_MINUTE=0
SV_DAILY_BACKFILL_DAYS=7

# Alert delivery. "none" sends nothing. "webhook" (easiest) POSTs {"text": ...} to
# SV_WEBHOOK_URL — works with Slack/Mattermost incoming webhooks, Discord (append /slack
# to the webhook URL), and ntfy. "email" sends via SMTP (fill the SV_SMTP_* fields; for
# Gmail use an app password).
SV_NOTIFY_CHANNEL=none
SV_WEBHOOK_URL=
SV_SMTP_HOST=
SV_SMTP_PORT=587
SV_SMTP_USERNAME=
SV_SMTP_PASSWORD=
SV_SMTP_FROM=
SV_SMTP_TO=
SV_SMTP_STARTTLS=true
